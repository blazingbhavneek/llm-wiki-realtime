# Committed template for .env. Copy it to the repo root as .env and fill in the
# addresses for your machines; .env itself is the real deployment file and is
# the one that holds the real hosts.
#
# Nothing here is a secret. Every address is the single-machine default, so the
# file works as-is when the browser, the model servers and the agent all run on
# one box. Split them and each 127.0.0.1 becomes the static IP of the machine
# that runs that service, e.g. LLM_BASE_URL=http://10.0.0.10:8000/v1 - see
# docs/OPERATIONS.md section 4. LIVEKIT_API_KEY/LIVEKIT_API_SECRET below are
# livekit-server's development defaults; change both before anything outside
# your machine can reach LiveKit.
#
# Hand-managed deployment configuration. Every service is an explicit
# host:port - nothing is auto-detected - so moving a service to another
# machine means editing exactly one line here and restarting that service.
#
# Everything defaults to this machine. When a service moves, set its URL to
# that machine's static IP, e.g. LLM_BASE_URL=http://10.0.0.12:8000/v1.
#
# PUBLIC_HOST below is the browser-facing address and the ONE value to change
# when this machine moves - the Caddyfile reads it too. After editing it, run
#     scripts/setup_https_livekit.sh
# which reads it back, reissues the certificate for the new name, and restarts
# the containers. It is idempotent and guesses nothing.


# --- Browser-facing origin ---------------------------------------------------
# The address the browser loads the UI from and opens the WebSocket to. Caddy
# terminates TLS here on :51027 and proxies /rtc* to LiveKit and everything
# else to the agent's web server. It is the only site address Caddy serves,
# so browsing to any other name gets no response even when the certificate
# covers it.
#
# On the work machine set this to that machine's static IP and re-run
# scripts/setup_https_livekit.sh (no argument - it reads this value), which
# reissues the certificate for the new name and restarts the containers.
# Also set LIVEKIT_NODE_IP to the same address: the browser must be able to
# reach the media candidates LiveKit advertises.
PUBLIC_HOST=10.160.152.38


# --- LiveKit -----------------------------------------------------------------
# LIVEKIT_URL is how the agent reaches LiveKit: same machine, so it skips
# Caddy and talks to the container directly. PUBLIC_LIVEKIT_URL is what the
# browser is told, so it goes through the TLS proxy on PUBLIC_HOST:51027.
LIVEKIT_URL=ws://10.160.152.38:7880
PUBLIC_LIVEKIT_URL=wss://10.160.152.38:51027
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_AGENT_NAME=japanese-wiki-agent
LIVEKIT_MANUAL_DISPATCH=true
# The address livekit-server advertises for media (ICE). It must match an
# interface the browser can actually reach, or the connection completes
# signalling and then times out waiting for the peer connection.
LIVEKIT_NODE_IP=10.160.152.38
# The agents worker's own internal health-check HTTP server. livekit-agents'
# own default is 8081; override if that port is already taken on this host.
LIVEKIT_AGENT_HTTP_PORT=8081
# livekit-agents logs tool-call execution (which function, what args) at
# DEBUG, invisible at its own prod default of INFO. Set to DEBUG to see it.
LIVEKIT_AGENT_LOG_LEVEL=INFO


# --- ASR ---------------------------------------------------------------------
# NVIDIA/NeMo-Speech.cpp on CPU (`uv run python -m app.stt.nemotron`, build
# once with scripts/build_asr_server.sh). The agent drives its /v1/realtime
# WebSocket through app.stt.nemotron.NemotronSTT.
# STT_BASE_URL=http://10.160.144.101:51028/v1
# STT_API_KEY=EMPTY
# STT_MODEL=mistralai/Voxtral-Mini-4B-Realtime-2602

# STT_BASE_URL=http://10.160.152.38:8003
# STT_API_KEY=EMPTY
# STT_MODEL=nvidia/nemotron-3.5-asr-streaming-0.6b

STT_BASE_URL=http://10.160.144.101:51027/v1
STT_API_KEY=EMPTY
STT_MODEL=Qwen/Qwen3-ASR-1.7B
# Must be a full language-locale. The model's prompt dictionary has ja-JP and
# ja-JA but no bare ja, and an unmatched code falls back to auto-detection.
# STT_LANGUAGE=ja
STT_LANGUAGE=ja-JP
# STT_USE_REALTIME=true
STT_USE_REALTIME=false

VAD_ACTIVATION_THRESHOLD=0.40

# --- LLM ---------------------------------------------------------------------
LLM_BASE_URL=http://10.160.144.101:51029/v1
LLM_API_KEY=EMPTY
LLM_MODEL=gemma-4-31B


# --- TTS ---------------------------------------------------------------------
# Supertonic-3 (ONNX, CPU) served by `uv run python -m app.tts.supertonic`.
TTS_BASE_URL=http://10.160.144.101:51026/v1
TTS_API_KEY=EMPTY
TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
# Built-in voices: M1-M5 (male), F1-F5 (female). Swap freely; see the
# audio_samples/ in the Supertone/supertonic-3 HF repo to pick by ear.
TTS_VOICE=Ono_Anna
# The TTS server's own language pin (Supertonic takes a `lang` code, not a text
# instruction) - TTS_INSTRUCTIONS below is sent but ignored by supertonic.
TTS_LANG=ja
TTS_INSTRUCTIONS=会話は日本語のみでお願いします。英語やローマ字、その他の言語に切り替えないでください。元気で明るい態度を保ち.


# --- Wiki / RAG --------------------------------------------------------------
# Debug-only stand-in for the real wiki backend, so `research_wiki` tool calls
# complete during live ASR/LLM testing instead of erroring out on an
# unreachable host. Answers are always the same placeholder string - never
# point this at anything but `uv run python -m app.rag.placeholder`.
LLM_WIKI_BASE_URL=http://10.160.152.38:51025
LLM_WIKI_PREFIX=/agent/llm-wiki
LLM_WIKI_DATABASE=wiki_moove
DEEP_RESEARCH_TIMEOUT_SECONDS=600
RAG_INITIAL_PLAN_TIMEOUT_SECONDS=10
RAG_LEVEL_TIMEOUT_SECONDS=150
RAG_STREAM_MAX_RETRIES=1


# --- Web/token server (app.web) ----------------------------------------------
TEXT_TEST_PORT=51028
# The agent's web server itself stays plain HTTP - Caddy terminates TLS in front.
# TEXT_TEST_HTTPS_HOSTS lists every name the generated certificate covers.
TEXT_TEST_TLS=false
TEXT_TEST_HTTPS_HOSTS=localhost,127.0.0.1,10.160.152.38


# --- Tuning ------------------------------------------------------------------
# Trailing silence before a turn is considered over. This is the largest
# controllable part of the gap between the user going quiet and the LLM being
# asked; the rest of that path measures ~140ms. Silero's default is 0.55.
VAD_MIN_SILENCE_SECONDS=0.55
# Set to 1 for a per-turn latency breakdown, or NEMO_STT_DEBUG=1 for an STT trace.
TURN_TIMING=0
# How many consecutive unrecoverable STT/LLM/TTS errors the session survives
# before LiveKit closes it and the agent leaves the room. The STT counter only
# resets when a transcript arrives, so LiveKit's default of 3 lets a backend
# that starts a minute late kill the session before the user has said a word.
SESSION_MAX_UNRECOVERABLE_ERRORS=10


# --- Component selection ---------------------------------------------------
# Which engine each provider package loads. See app/<name>/README.md for the
# registered names and what each one expects.
STT_PROVIDER=qwen
TTS_PROVIDER=qwen3
LLM_PROVIDER=openai_compatible
RAG_PROVIDER=llm_wiki
