{
    # Another service already owns port 80.
    auto_https disable_redirects
}

# The site address comes from PUBLIC_HOST in .env, passed into the container by
# docker-compose.caddy.yml, so the browser-facing address is set in exactly one
# place. The certificate must cover that same name - regenerate it after a
# change with: scripts/setup_https_livekit.sh $PUBLIC_HOST
https://{$PUBLIC_HOST}:51027 {
    tls /etc/caddy/certs/text-test-cert.pem /etc/caddy/certs/text-test-key.pem

    # LiveKit's signaling WebSocket and validation endpoint.
    @livekit path /rtc /rtc/*
    reverse_proxy @livekit 127.0.0.1:7880

    # The UI/token server stays private and is exposed through this same TLS
    # origin, avoiding a second browser-visible port and CORS/TLS split.
    reverse_proxy 127.0.0.1:51028
}
